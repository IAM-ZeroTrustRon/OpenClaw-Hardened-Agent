// openclaw.example.json5
//
// Sanitised example of ~/.openclaw/openclaw.json after the build and both
// hardening fixes.
//
// PLACEHOLDERS ONLY. Every value in angle brackets must be replaced.
// The real openclaw.json is in .gitignore and is never committed.
//
// Known gap: OpenClaw stores these keys in plaintext. Moving them to
// SecretRef is an open item. See docs/03-hardening.md.
{
  gateway: {
    // Loopback only. Not 0.0.0.0, not the LAN address.
    // This is the single most important line in the file.
    bind: "127.0.0.1",
    port: 18789,

    // Generated by the onboarding wizard. Stored in plaintext today.
    // SecretRef is the planned replacement.
    secret: "<GATEWAY_SECRET>",

    // No inbound HTTP path into the agent.
    webhooks: { enabled: false },

    tailscale: { enabled: false },
  },

  providers: {
    // Primary. Custom OpenAI-compatible provider added after the
    // Gemini free tier could not keep up. See docs/02-build-guide.md step 6.
    clinepass: {
      baseUrl: "https://api.cline.bot/api/v1",
      api: "openai-completions",
      apiKey: "<CLINEPASS_API_KEY>",
      models: {
        "cline-pass/qwen3.7-max": {
          contextWindow: 128000,
          maxTokens: 8192,
        },
      },
    },

    // Fallback. AI Studio free tier, billing NOT enabled, on a
    // dedicated agent Gmail account rather than a personal one.
    google: {
      apiKey: "<GEMINI_API_KEY>",
    },
  },

  agents: {
    defaults: {
      model: {
        primary: "clinepass/cline-pass/qwen3.7-max",
        fallback: "google/gemini-3.8-flash",
      },
    },
  },

  tools: {
    fs: {
      // HARDENING FIX 1. Default was false.
      // File tools are confined to ~/.openclaw/workspace.
      workspaceOnly: true,
    },

    // OPEN GAP. Runtime and process tools run unsandboxed.
    // Full sandbox mode ("all") needs Docker inside the distro. Deferred.
    // Distro isolation is the compensating control, not a replacement.
    sandbox: { mode: "off" },
  },

  channels: {
    telegram: {
      enabled: true,
      botToken: "<TELEGRAM_BOT_TOKEN>",

      // Only paired accounts may DM the agent.
      dmPolicy: "pairing",
      allowedUsers: ["<TELEGRAM_USER_ID>"],

      // HARDENING FIX 2.
      // The wizard wrote: groups: { "*": { requireMention: true } }
      // That wildcard let ANY Telegram group use the bot.
      // The groups block was removed and group access explicitly denied.
      groupPolicy: "disabled",
    },
  },

  plugins: {
    // Official @openclaw npm scope only. Community ClawHub was skipped.
    // OPEN GAP: this spec is unpinned. Audit warning
    // plugins.installs_unpinned_npm_specs. Pinning is a low-priority
    // open item.
    installs: [
      "@openclaw/duckduckgo-plugin",
    ],
  },

  // Deliberately empty. Every skill is code running with the agent's
  // privileges. Start at zero, add only what can be justified.
  skills: [],
}
